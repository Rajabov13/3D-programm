{
  "name": "3d-code-world",
  "private": true,
  "version": "1.0.0",
  "description": "3D Code World (demo version) — learn programming by exploring an interactive 3D technology city.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:bosses": "node scripts/verify-bosses.cjs",
    "smoke": "node scripts/smoke-test.cjs",
    "postinstall": "node scripts/copy-pyodide.mjs",
    "prebuild": "node scripts/copy-pyodide.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.1",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@monaco-editor/react": "4.7.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "acorn": "8.14.0",
    "acorn-walk": "8.3.4",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.52.2",
    "pyodide": "0.26.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "sucrase": "3.35.0",
    "three": "0.170.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
